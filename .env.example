# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://localhost:5432/jobsmith

# --- Auth.js --------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Resend (magic link). Leave AUTH_RESEND_KEY empty in dev to print the link in the server console.
AUTH_RESEND_KEY=
EMAIL_FROM="Jobsmith <login@your-domain.com>"

# --- Storage (Cloudflare R2 via S3 API) ------------------------------------
# r2 in production. "local" is a dev-only filesystem driver (.data/storage).
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOADS_BUCKET=jobsmith-uploads
R2_EXPORTS_BUCKET=jobsmith-exports
# Signs local-driver URLs. Defaults to AUTH_SECRET when empty.
STORAGE_SIGNING_SECRET=

# --- LLM (Vercel AI SDK, behind src/lib/llm) ---------------------------------
# anthropic | openai | google
LLM_PROVIDER=anthropic
# e.g. claude-sonnet-5-5 | gpt-5 | gemini-2.5-pro  (any model id the provider accepts)
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
