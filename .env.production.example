# Production / Preview environment for Vercel. Copy the NAMES into Vercel → Project → Settings → Environment Variables
# (or `vercel env add NAME production`). Never commit real values. Check a filled-in file with:
#   npm run env:check -- .env.production --prod

# --- Database: Neon ---------------------------------------------------------------
# Pooled connection (host contains "-pooler"): used by the running app.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct connection (no "-pooler"): used only for migrations during the build.
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- Auth ---------------------------------------------------------------------------
# A NEW secret for production (openssl rand -base64 32). Never reuse the development one.
AUTH_SECRET=
# Leave unset on Vercel (the host is detected). Set only if you use a custom domain behind a proxy.
# AUTH_URL=https://jobsmith.example.com
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Required in production: magic-link emails. EMAIL_FROM must use a domain verified in Resend.
AUTH_RESEND_KEY=
EMAIL_FROM="Jobsmith <login@your-verified-domain.com>"
# Who may sign in. STRONGLY recommended for a personal deployment. Comma-separated emails or @domains.
ALLOWED_EMAILS=

# --- Storage: Cloudflare R2 (required in production) ----------------------------------
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOADS_BUCKET=jobsmith-uploads
R2_EXPORTS_BUCKET=jobsmith-exports

# --- AI (optional: users can add their own keys in Settings) ---------------------------
# A server key is a shared fallback: everyone who can sign in can spend it. Use ALLOWED_EMAILS if you set one.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Encrypts users' own API keys at rest. Optional; defaults to AUTH_SECRET.
APP_ENCRYPTION_KEY=

# --- Reminders ---------------------------------------------------------------------
# Vercel Cron (vercel.json) sends this as "Authorization: Bearer <CRON_SECRET>" automatically.
CRON_SECRET=
